# Frontend Environment Variables

# In Local Development:
# Leave this blank. Vite's proxy automatically routes /api requests to http://localhost:5055.
VITE_API_URL=

# In Production Deployment (e.g., Vercel, Netlify, Render):
# Set this to your deployed Render backend URL, for example:
# VITE_API_URL=https://class-pilot.onrender.com
