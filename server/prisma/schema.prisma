datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  studentId        String          @unique
  name             String
  email            String          @unique
  passwordHash     String
  targetPercentage Float           @default(75.0)
  collegeName      String?         @default("SRM Institute of Science & Technology")
  department       String?         @default("Computer Science & Engineering")
  semester         Int?            @default(5)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  subjects         Subject[]
  attendanceLogs   AttendanceLog[]
}

model Subject {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  userId          String          @db.ObjectId
  subjectCode     String?
  subjectName     String
  teacherName     String?
  targetOverride  Float?
  color           String?         @default("#3B82F6")
  totalClasses    Int             @default(0)
  attendedClasses Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs            AttendanceLog[]

  @@index([userId])
}

model AttendanceLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  subjectId String   @db.ObjectId
  date      DateTime @default(now())
  status    String   // "PRESENT" | "ABSENT" | "CANCELLED"
  notes     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([userId, subjectId])
  @@index([date])
}
